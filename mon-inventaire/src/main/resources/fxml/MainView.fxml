<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.monsite.inventaire.controller.MainController">

    <!-- TOP: MENU -->
    <top>
        <MenuBar style="-fx-background-color: #2c3e50;">
            <Menu text="📊 Tableau de bord" style="-fx-text-fill: white;">
                <MenuItem text="Accueil"/>
            </Menu>
            <Menu text="🛒 Produits" style="-fx-text-fill: white;">
                <MenuItem text="Gestion des produits" 
                         onAction="#showProductManagement"/>
                <MenuItem text="Inventaire"/>
            </Menu>
            <Menu text="📦 Commandes" style="-fx-text-fill: white;">
                <MenuItem text="Gestion des commandes" 
                         onAction="#showCommandManagement"/>
                <MenuItem text="Nouvelle commande"/>
            </Menu>
            <Menu text="👥 Clients" style="-fx-text-fill: white;">
                <MenuItem text="Gestion des clients" 
                         onAction="#showUserManagement"/>
            </Menu>
            <Menu text="⚙️ Administration" style="-fx-text-fill: white;">
                <MenuItem text="Paramètres"/>
                <MenuItem text="Sauvegarde"/>
                <SeparatorMenuItem/>
                <MenuItem text="Quitter"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- CENTER: CONTENU DYNAMIQUE -->
    <center>
        <StackPane fx:id="contentPane" style="-fx-background-color: #f5f5f5;">
            <!-- Le contenu sera chargé dynamiquement ici -->
            <Label text="Bienvenue dans le système d'inventaire" 
                   style="-fx-font-size: 24px; -fx-text-fill: #7f8c8d;"/>
        </StackPane>
    </center>

    <!-- BOTTOM: STATUT -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 5 10;">
            <Label fx:id="statusLabel" text="Prêt" 
                   style="-fx-text-fill: #2c3e50;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Système d'Inventaire v1.0" 
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>