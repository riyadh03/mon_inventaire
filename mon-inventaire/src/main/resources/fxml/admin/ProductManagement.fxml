<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.monsite.inventaire.controller.admin.ProductManagementController"
      spacing="10"
      style="-fx-background-color: #f5f5f5; -fx-padding: 20;">

    <!-- TITRE -->
    <Label text="🎯 GESTION DES PRODUITS" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <padding>
            <Insets bottom="10"/>
        </padding>
    </Label>

    <!-- SECTION RECHERCHE API -->
    <VBox fx:id="apiResultsContainer" spacing="10" 
          style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-border-color: #ddd;">
        <Label text="🔍 Recherche API Open Food Facts" 
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        
        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="Entrez un nom de produit (ex: nutella, coca...)" 
                       HBox.hgrow="ALWAYS"/>
            <Button text="Rechercher" onAction="#handleSearch" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
        
        <Label fx:id="searchStatusLabel" text=""/>
        
        <!-- Résultats API -->
        <VBox spacing="5">
            <Label text="Résultats de recherche:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="searchResultsCombo" promptText="Sélectionnez un produit" 
                      prefWidth="400"/>
            <Button fx:id="importButton" text="Importer ce produit" onAction="#handleImport"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
        </VBox>
    </VBox>

    <!-- SECTION PRINCIPALE : TABLEAU + FORMULAIRE -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- COLONNE GAUCHE : TABLEAU DES PRODUITS -->
        <VBox spacing="10" prefWidth="600" HBox.hgrow="ALWAYS">
            <Label text="📋 Liste des produits en stock" 
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            
            <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="codeColumn" text="Code" prefWidth="100"/>
                    <TableColumn fx:id="nameColumn" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="brandColumn" text="Marque" prefWidth="120"/>
                    <TableColumn fx:id="categoryColumn" text="Catégorie" prefWidth="120"/>
                    <TableColumn fx:id="quantityColumn" text="Stock" prefWidth="80"/>
                    <TableColumn fx:id="priceColumn" text="Prix (€)" prefWidth="80"/>
                    <TableColumn fx:id="nutriScoreColumn" text="Nutri-Score" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            
            <!-- BOUTONS ACTION TABLEAU -->
            <HBox spacing="10">
                <Button text="Nouveau produit" onAction="#clearForm" 
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                <Button text="Supprimer" onAction="#handleDelete" 
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statsLabel" text="Produits: 0 | Valeur: 0€" 
                       style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;"/>
            </HBox>
        </VBox>

        <!-- COLONNE DROITE : FORMULAIRE DÉTAILS -->
        <VBox spacing="15" prefWidth="400" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 5; -fx-border-color: #ddd;">
            <Label text="📝 Détails du produit" 
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <!-- IMAGE PRODUIT -->
            <ImageView fx:id="productImageView" fitWidth="150" fitHeight="150" 
                       preserveRatio="true"
                       style="-fx-border-color: #ddd; -fx-border-radius: 5;">
                <VBox.margin>
                    <Insets bottom="10"/>
                </VBox.margin>
            </ImageView>
            
            <!-- FORMULAIRE -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>
                
                <!-- Ligne 1: Code -->
                <Label text="Code-barres:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                
                <!-- Ligne 2: Nom -->
                <Label text="Nom*:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                
                <!-- Ligne 3: Marque -->
                <Label text="Marque:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="brandField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                
                <!-- Ligne 4: Catégorie -->
                <Label text="Catégorie:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="categoryField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                
                <!-- Ligne 5: Origine -->
                <Label text="Origine:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="originsField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                
                <!-- Ligne 6: Nutri-Score -->
                <Label text="Nutri-Score:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="nutriScoreField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                
                <!-- Ligne 7: Eco-Score -->
                <Label text="Eco-Score:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="ecoScoreField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                
                <!-- Ligne 8: Prix -->
                <Label text="Prix (€)*:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                
                <!-- Ligne 9: Quantité -->
                <Label text="Quantité*:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <TextField fx:id="quantityField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
            </GridPane>
            
            <!-- INFOS SUPPLÉMENTAIRES -->
            <VBox spacing="5">
                <Label text="Allergènes:" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="allergensArea" prefRowCount="3" 
                          promptText="Liste d'allergènes (séparés par des virgules)"
                          style="-fx-border-color: #ddd;"/>
                
                <HBox spacing="10">
                    <Label fx:id="veganLabel" text="" style="-fx-font-weight: bold;"/>
                    <Label fx:id="nutritionLabel" text="" style="-fx-font-style: italic; -fx-text-fill: #7f8c8d;"/>
                </HBox>
            </VBox>
            
            <!-- BOUTONS SAUVEGARDE -->
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button text="Sauvegarder" onAction="#handleSave" 
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 120;"/>
                <Button text="Annuler" onAction="#clearForm" 
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </HBox>
            
            <!-- NOTE -->
            <Label text="* Champs obligatoires" 
                   style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </HBox>

</VBox>